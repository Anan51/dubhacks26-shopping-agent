{
  "name": "dubhacks26-shopping-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:agent": "tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "tsc && vite build --config web/vite.config.ts",
    "test": "tsx --test src/*.test.ts",
    "smoke:grok": "tsx src/smoke-grok.ts"
  },
  "dependencies": {
    "@photon-ai/api": "0.5.0",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "4.8.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
