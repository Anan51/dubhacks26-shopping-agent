{
  "name": "simmer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:demo": "node scripts/dev-demo.mjs",
    "dev:agent": "tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "build": "tsc && vite build --config web/vite.config.ts && vite build --config extension/vite.config.ts",
    "build:demo": "node scripts/build-demo.mjs",
    "test": "tsx --test src/*.test.ts src/auth/*.test.ts src/memory/*.test.ts src/purchases/*.test.ts extension/src/*.test.ts",
    "smoke:grok": "tsx src/smoke-grok.ts",
    "check:mongo": "tsx src/check-mongo.ts"
  },
  "dependencies": {
    "@photon-ai/api": "0.5.0",
    "argon2": "^0.45.1",
    "express": "^4.22.3",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "4.8.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
