{
  "manifest_version": 3,
  "name": "Simmer",
  "version": "0.2.0",
  "description": "Marinates an Apple or Amazon bag so the shopper can decide. Simmer never places the order.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.apple.com/shop/bag*",
    "https://www.apple.com/*/shop/bag*",
    "https://www.apple.com.cn/shop/bag*",
    "https://www.apple.com.cn/*/shop/bag*",
    "https://*.store.apple.com/*checkout*",
    "https://*.store.apple.com/*Checkout*",
    "https://www.amazon.com/gp/cart*",
    "https://www.amazon.com/cart*",
    "https://www.amazon.com/gp/buy/*",
    "https://www.amazon.com/checkout/*",
    "https://amazon.com/gp/cart*",
    "https://amazon.com/cart*",
    "https://amazon.com/gp/buy/*",
    "https://amazon.com/checkout/*",
    "http://127.0.0.1:4321/*",
    "http://localhost:4321/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Simmer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.apple.com/shop/bag*",
        "https://www.apple.com/*/shop/bag*",
        "https://www.apple.com.cn/shop/bag*",
        "https://www.apple.com.cn/*/shop/bag*",
        "https://*.store.apple.com/*checkout*",
        "https://*.store.apple.com/*Checkout*",
        "https://www.amazon.com/gp/cart*",
        "https://www.amazon.com/cart*",
        "https://www.amazon.com/gp/buy/*",
        "https://www.amazon.com/checkout/*",
        "https://amazon.com/gp/cart*",
        "https://amazon.com/cart*",
        "https://amazon.com/gp/buy/*",
        "https://amazon.com/checkout/*",
        "http://127.0.0.1:4321/fallback*",
        "http://localhost:4321/fallback*",
        "http://127.0.0.1:4321/amazon*",
        "http://localhost:4321/amazon*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
