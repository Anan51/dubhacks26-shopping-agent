# Photon 2.0 Beta (https://photon.codes/docs/beta/). No real values in git.

# Project API key (pho_sk_...). Shown once under API keys. Needs project:read and project:write.
PHOTON_API_KEY=

# Project ID (pho_prj_...) from project Settings.
PHOTON_PROJECT_ID=

# Channel. Set to imessage. Leave empty to stay on the desk stub.
PHOTON_PLATFORM=

# Shared-pool number Photon assigned (the agent), E.164.
PHOTON_AGENT_HANDLE=

# Your iMessage phone (E.164) or Apple ID email, used when assigning the shared line.
# The echo agent does not filter on this; each tester needs their own assignment.
PHOTON_TEST_SENDER=

# Demo/test iMessage recipient (E.164). Placeholder only — do not commit a real number.
# PHOTON_TEST_NUMBER=+15555550100

# Optional API origin for the HTTP client and the live Socket.IO connection.
# Defaults to https://api.photon.codes
# PHOTON_API_ORIGIN=https://api.photon.codes

# Webhook destination signing secret (whsec_...), shown once when the destination is created.
# Required by the Vercel route. Beta docs do not yet document how to verify it; see api/webhook.ts.
PHOTON_WEBHOOK_SECRET=

# Simmer. Env names stay WAITMATE_ so an existing local setup keeps working.
# Leave Photon blank until an iMessage line is connected. Replies that unlock a bag are graded texts.

# auto uses Photon when the key, project, platform, and agent handle are all set. Otherwise desk chat.
# WAITMATE_CHANNEL=auto

# Page and API port. Defaults to 4321. The extension matches this port.
# WAITMATE_PORT=4321

# Links in reminder texts. Defaults to http://localhost:$WAITMATE_PORT
# WAITMATE_PUBLIC_ORIGIN=http://localhost:4321

# Soft marinating timer in milliseconds. Default is 10 minutes. Unlock stays visible the whole time.
# WAITMATE_LOCK_MS=600000

# Set to 1 for demo mode. `npm run dev:demo` sets this. It allows POST /api/dev/reply
# outside production. The default `npm run build` does not include the extension's
# simulate-reply control; `npm run build:demo` sets VITE_SIMMER_DEMO=1 for that.
# WAITMATE_DEMO=1

# How soon a demo-mode reminder fires. Default is 1 minute.
# WAITMATE_DEMO_REMINDER_MS=60000

# Optional JSON file for carts, chats, and linked phones. Unset uses in-memory storage.
# WAITMATE_STORE_PATH=data/waitmate.json

# Optional. Grok parses free-text signals and can rephrase the reply. Never commit a value.
XAI_API_KEY=

# Optional model override. Empty uses grok-4.20-0309-non-reasoning.
XAI_MODEL=

# Grok call timeout in milliseconds. Empty uses 8000.
XAI_TIMEOUT_MS=
