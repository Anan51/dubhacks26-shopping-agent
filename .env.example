# Photon 2.0 Beta (https://photon.codes/docs/beta/). No real values in git.

# Project API key (pho_sk_...). Shown once under API keys. Needs project:read and project:write.
PHOTON_API_KEY=

# Project ID (pho_prj_...) from project Settings.
PHOTON_PROJECT_ID=

# Channel this scaffold answers.
PHOTON_PLATFORM=imessage

# Shared-pool number Photon assigned (the agent), E.164.
PHOTON_AGENT_HANDLE=

# Your iMessage phone (E.164) or Apple ID email, used when assigning the shared line.
# The echo agent does not filter on this; each tester needs their own assignment.
PHOTON_TEST_SENDER=

# Optional API origin for the HTTP client and the live Socket.IO connection.
# Defaults to https://api.photon.codes
# PHOTON_API_ORIGIN=https://api.photon.codes

# Webhook destination signing secret (whsec_...), shown once when the destination is created.
# Required by the Vercel route. Beta docs do not yet document how to verify it; see api/webhook.ts.
PHOTON_WEBHOOK_SECRET=

# WaitMate. Leave Photon blank to use the desk chat at /dev.

# auto uses Photon when the key, project, platform, and agent handle are all set. Otherwise desk chat.
# WAITMATE_CHANNEL=auto

# Page and API port. Defaults to 4321.
# WAITMATE_PORT=4321

# Links in reminder texts. Defaults to http://localhost:$WAITMATE_PORT
# WAITMATE_PUBLIC_ORIGIN=http://localhost:4321

# Cooling-off lock length in milliseconds. Default is 10 minutes.
# WAITMATE_COOLING_MS=600000

# Set to 1 to treat a checkout with no demo flag as demo mode.
# WAITMATE_DEMO=0

# How soon a demo-mode reminder fires. Default is 1 minute.
# WAITMATE_DEMO_REMINDER_MS=60000

# JSON file for carts and desk transcripts. Defaults to data/waitmate.json
# WAITMATE_STORE_PATH=data/waitmate.json

# Optional. Grok rewrites the buy/wait text. The call itself stays deterministic. Never commit a value.
XAI_API_KEY=
